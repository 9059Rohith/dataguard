# Copy to .env (ignored). Use URL-safe values for Compose DATABASE_URL interpolation.
POSTGRES_PASSWORD=replace_with_random_url_safe_local_database_password
DATAGUARD_TOKEN=replace_with_random_operator_token_at_least_32_characters
DATAGUARD_PUBLIC_DEMO=false
DATAGUARD_SEED_DEMO=false
# Gemini only: exact allowlist gemini-3.5-flash-lite or gemini-3.1-flash-lite.
# Unset uses 3.5; invalid/empty values disable Gemini before quota or network.
# Server pin applies for the entire investigation; no automatic model failover.
DATAGUARD_GEMINI_MODEL=gemini-3.5-flash-lite
