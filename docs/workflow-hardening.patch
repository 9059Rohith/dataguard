diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 60d0a99..a010a1a 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -11,8 +11,10 @@ jobs:
         ports: ["5432:5432"]
         options: --health-cmd="pg_isready -U dataguard" --health-interval=3s --health-retries=20
     steps:
-      - uses: actions/checkout@v4
